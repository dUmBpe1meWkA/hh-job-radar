# Telegram
TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_CHAT_ID=123456789

# HH API. User-Agent обязателен. Формат: AppName/Version (email)
HH_USER_AGENT=hh-job-radar/1.0 (your_email@example.com)

# HH OAuth app: https://dev.hh.ru/admin
HH_CLIENT_ID=replace_me
HH_CLIENT_SECRET=replace_me
HH_REDIRECT_URI=https://your-domain.example/hh/callback

# ID резюме на hh. Можно взять из URL резюме или задать командой /set_resume <id>
HH_RESUME_ID=

# Search settings
AREA=1
MIN_SCORE=65
SCAN_INTERVAL_MINUTES=180
MAX_PAGES_PER_QUERY=2
PER_PAGE=20
PUBLICATION_PERIOD_DAYS=3

# Local OAuth callback server. Закрой наружу reverse proxy + HTTPS.
OAUTH_HOST=0.0.0.0
OAUTH_PORT=8080

# SQLite path inside container/host
DB_PATH=/app/data/job_radar.sqlite3
